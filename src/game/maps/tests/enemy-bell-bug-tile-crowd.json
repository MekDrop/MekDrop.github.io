      "color": "#334433",
      "script": "if(active&&!trigger.started){trigger.started=true;setTimeout(()=>{\nconst ref=[...objects].find(o=>o.definition?.id==='bell-reference'),bugs=[...objects].filter(o=>o.definition?.id?.startsWith('crowd-')),slugs=[...objects].filter(o=>o.definition?.id?.startsWith('slug-'));\nref.app.root.findByName('Map test controls').enabled=false;const camera=ref.runtime.camera;\nconst start=performance.now(),samples=[],chunks=[];let started=false,cleared=false,done=false,lastSample=0,halfX=0,halfZ=0;\nconst stream=document.querySelector('canvas').captureStream(30),rec=new MediaRecorder(stream,{mimeType:'video/webm;codecs=vp8'});rec.ondataavailable=e=>chunks.push(e.data);rec.onstop=()=>{const r=new FileReader();r.onload=()=>{const a=document.createElement('a');a.id='bell-crowd-video';a.href=r.result;a.hidden=true;document.body.appendChild(a)};r.readAsDataURL(new Blob(chunks,{type:'video/webm'}));stream.getTracks().forEach(t=>t.stop())};rec.start();\nref.inspectClip('scuttle_walk');\nconst cameraHandle=ref.app.on('prerender',()=>{const seconds=(performance.now()-start)/1000;const p=seconds<3?ref.position:new ref.pc.Vec3(.5,2,-.5);camera.component.orthoHeight=seconds<3?1.15:4.6;camera.entity.setPosition(p.x+4,p.y+5,p.z+6);camera.entity.lookAt(p.clone().add(new ref.pc.Vec3(0,.25,0)))});\nconst update=ref.app.on('update',()=>{if(!ref.entity.rigidbody){update.off();cameraHandle.off();if(rec.state!=='inactive')rec.stop();return}const seconds=(performance.now()-start)/1000;\nif(seconds<3){const yaw=Math.floor(seconds)*45;ref.entity.rigidbody.teleport(ref.position,new ref.pc.Vec3(0,yaw,0));const meshes=ref.entity.findComponents('render').flatMap(r=>r.meshInstances);for(const m of meshes){const a=m.aabb;halfX=Math.max(halfX,Math.abs(a.center.x-ref.position.x)+a.halfExtents.x);halfZ=Math.max(halfZ,Math.abs(a.center.z-ref.position.z)+a.halfExtents.z)}}\nif(seconds>=3&&!started){started=true;ref.inspectClip('idle_nervous');for(const b of bugs){const goal={position:new ref.pc.Vec3(b.position.x,2,5.5)};b.resolveRoyalTarget=()=>goal;b.transition('BellBugPursueState')}}\nif(seconds>=10&&!cleared){cleared=true;for(const [i,s] of slugs.entries())s.entity.rigidbody.teleport(new ref.pc.Vec3(i?5:-3,2.05,1.2),new ref.pc.Vec3())}\nif(seconds-lastSample>.1){samples.push({time:seconds,bugs:bugs.map(b=>({id:b.definition.id,x:b.position.x,y:b.position.y,z:b.position.z,speed:Math.hypot(b.entity.rigidbody.linearVelocity.x,b.entity.rigidbody.linearVelocity.z)}))});lastSample=seconds}\nif(seconds>=19&&!done){done=true;update.off();rec.stop();for(const b of bugs)b.inspectClip('idle_nervous');const stable=samples.filter(s=>s.time>3.5),maxY=Math.max(...stable.flatMap(s=>s.bugs.map(b=>b.y))),last=samples.at(-1).bugs;const report={tileFit:halfX<.5&&halfZ<.5,halfX,halfZ,maxRootY:maxY,noRiding:maxY<2.09,released:Math.min(...last.map(b=>b.z))>2,samples};const a=document.createElement('a');a.id='bell-crowd-report';a.href='data:application/json;base64,'+btoa(JSON.stringify(report));a.hidden=true;document.body.appendChild(a);console.info('BELL_CROWD_RESULT',JSON.stringify({...report,samples:samples.length}));setTimeout(async()=>{const click=HTMLAnchorElement.prototype.click;HTMLAnchorElement.prototype.click=function(){this.id='bell-crowd-preview';this.hidden=true;document.body.appendChild(this)};try{console.info('BELL_CROWD_PREVIEW',JSON.stringify(await ref.capturePreview()))}finally{HTMLAnchorElement.prototype.click=click}},500)}\n});\n},1600)}"
    }
