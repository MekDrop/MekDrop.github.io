    "panels": [
      {
        "title": "Hero digging",
        "x": 16,
        "y": 140,
        "buttons": [
          {
            "label": "Dig",
            "script": "for(const hero of objects.getAll('hero')) { const p=hero.position; hero.useTool(hero.tools.get('ShovelTool'), {targetPosition:{x:p.x,y:p.y,z:p.z+0.535},context:{action:'dig'}}); }"
          },
          {
            "label": "Fill",
            "script": "for(const hero of objects.getAll('hero')) { const p=hero.position; hero.useTool(hero.tools.get('ShovelTool'), {targetPosition:{x:p.x,y:p.y,z:p.z+0.535},context:{action:'fill'}}); }"
          },
          {
            "label": "Stop",
            "script": "for(const hero of objects.getAll('hero')) { hero.stopUsingTool(); }"
          }
        ]
      },
      {
        "title": "Viewing angle",
        "x": 16,
        "y": 320,
        "buttons": [
          {
            "label": "Angle 1",
            "script": "camera.setViewport({zoom: 5, rotation: 0, panX: 0, panZ: 0});"
          },
          {
            "label": "Angle 2",
            "script": "camera.setViewport({zoom: 5, rotation: 1, panX: 0, panZ: 0});"
          },
          {
            "label": "Angle 3",
            "script": "camera.setViewport({zoom: 5, rotation: 2, panX: 0, panZ: 0});"
          },
          {
            "label": "Angle 4",
            "script": "camera.setViewport({zoom: 5, rotation: 3, panX: 0, panZ: 0});"
          }
        ]
      }
