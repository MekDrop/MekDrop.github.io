  "testControls": {
    "panels": [
      {
        "title": "Ride the falling bridge",
        "statusTargetId": "bridge-x-5-17.5-2",
        "buttons": [
          {
            "label": "Rider view",
            "script": "objects.getOne('hero').teleport({x:-.5,y:2.4,z:7});camera.setViewport({zoom:2.6,rotation:0,panX:0,panZ:7});"
          },
          {
            "label": "Hammer middle",
            "script": "const bridge=[...objects].find(o=>o.definition?.id==='bridge-x-5-17.5-2');const hero=objects.getOne('hero');hero.teleport({x:-.5,y:2.4,z:7});camera.setViewport({zoom:2.6,rotation:0,panX:0,panZ:7});window.setTimeout(()=>hero.smashBridge({targetX:.5,targetZ:7,onImpact:()=>bridge.collapseStation(8)}),400);"
          },
          {
            "label": "Drop occupied section",
            "script": "const bridge=[...objects].find(o=>o.definition?.id==='bridge-x-5-17.5-2');const hero=objects.getOne('hero');camera.setViewport({zoom:2.6,rotation:0,panX:0,panZ:7});bridge.collapseStation(Math.round(hero.position.x+(map.cols-1)/2));"
          },
          {
            "label": "Hard landing",
            "script": "objects.getOne('hero').teleport({x:3.5,y:5,z:7});camera.setViewport({zoom:3,rotation:0,panX:3.5,panZ:7});"
          },
          {
            "label": "Recovery rear view",
            "script": "objects.getOne('hero').teleport({x:3.5,y:5,z:7});camera.setViewport({zoom:4,rotation:2,panX:3.5,panZ:7});"
          },
          {
            "label": "Reverse view",
            "script": "camera.setViewport({zoom:2.6,rotation:2,panX:0,panZ:7});"
          }
        ]
      }
    ]
  }
