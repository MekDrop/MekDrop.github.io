  "testControls": {
    "panels": [
      {
        "title": "Mask Shaman",
        "x": 16,
        "y": 140,
        "statusTargetId": "mask-shaman-main",
        "buttons": [
          {
            "label": "Resume discipline",
            "script": "for (const actor of objects) { if (actor.definition?.id === 'mask-shaman-main') { actor.testClip=null; } }"
          },
          {
            "label": "Bell (2s)",
            "script": "for (const actor of objects) { if (actor.definition?.id === 'mask-shaman-main') { actor.onBellRung({eventId: Symbol(),duration:2}); } }"
          },
          {
            "label": "Hit / interrupt",
            "script": "for (const actor of objects) { if (actor.definition?.id === 'mask-shaman-main') { actor.receiveDamage(1); } }"
          },
          {
            "label": "Stun (2s)",
            "script": "for (const actor of objects) { if (actor.definition?.id === 'mask-shaman-main') { actor.applyStatus('stun',{duration:2}); } }"
          },
          {
            "label": "Carry by ally",
            "script": "for (const actor of objects) { if (actor.definition?.id === 'mask-shaman-main') { const ally=[...objects].find(o=>o.definition?.id==='mask-shaman-ally');actor.beginCarry(ally); } }"
          },
          {
            "label": "Throw (Ammo)",
            "script": "for (const actor of objects) { if (actor.definition?.id === 'mask-shaman-main') { actor.launch({velocity:{x:-1,y:5,z:1}}); } }"
          },
          {
            "label": "Defeat",
            "script": "for (const actor of objects) { if (actor.definition?.id === 'mask-shaman-main') { actor.receiveDamage(actor.health); } }"
          },
          {
            "label": "Verify all clips",
            "script": "for (const actor of objects) { if (actor.definition?.id === 'mask-shaman-main') { void actor.checks.verifyClips(); } }"
          },
          {
            "label": "Save transparent preview",
            "script": "for (const actor of objects) { if (actor.definition?.id === 'mask-shaman-main') { void actor.checks.preview(); } }"
          },
          {
            "label": "Half time",
            "script": "for (const actor of objects) { if (actor.definition?.id === 'mask-shaman-main') { actor.app.timeScale=.5; } }"
          },
          {
            "label": "Normal time",
            "script": "for (const actor of objects) { if (actor.definition?.id === 'mask-shaman-main') { actor.app.timeScale=1; } }"
          },
          {
            "label": "Verify behavior",
            "script": "for(const a of objects){if(a.definition?.id==='mask-shaman-main')void a.checks.verifyBehavior();}"
          }
        ]
