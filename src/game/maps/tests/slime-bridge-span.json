  "testControls": {
    "panels": [
      {
        "title": "Slime span",
        "statusTargetId": "bridge-x-5-17.5-2",
        "buttons": [
          {
            "label": "Collapse and rebuild",
            "script": "const bridge=[...objects].find(o=>o.definition?.object==='Bridge'&&o.definition.span?.start===5&&o.definition.span?.crossCenter===17.5);if(bridge){objects.getOne('hero').teleport({x:0,y:0.64,z:8.5});const donors=[...objects].filter(o=>o.definition?.id?.startsWith('span-slug-'));for(const slug of donors){slug.entity.enabled=false;slug.entity.rigidbody.enabled=false;slug.entity.collision.enabled=false;}bridge.collapseStation(5);let index=0;const release=()=>{if(index>=donors.length){window.clearInterval(timer);return;}if(!bridge.rebuildDemand){if(index>0)window.clearInterval(timer);return;}if(bridge.rebuildDemand.count<=0)return;const occupied=donors.slice(0,index).some(slug=>slug.alive&&slug.entity.enabled&&!slug.isBridgeCommitted&&slug.position.distance(new slug.pc.Vec3(-4.85,2,7))<2);if(occupied)return;const slug=donors[index++];slug.entity.setPosition(-4.85,2,7);slug.entity.rigidbody.teleport(-4.85,2,7);slug.entity.collision.enabled=true;slug.entity.rigidbody.enabled=true;slug.entity.enabled=true;slug.entity.rigidbody.linearVelocity=new slug.pc.Vec3();slug.grounded=false;slug.airborne=true;slug.resumeBehavior();};const timer=window.setInterval(release,8000);const kickoff=window.setTimeout(release,3500);bridge.entity.once(\"destroy\",()=>{window.clearInterval(timer);window.clearTimeout(kickoff);});}"
          },
          {
            "label": "Span view",
            "script": "camera.setViewport({zoom:1.5,rotation:0,panX:0,panZ:7});"
          },
          {
            "label": "Close view",
            "script": "camera.setViewport({zoom:5,rotation:0,panX:-1,panZ:7});"
          },
          {
            "label": "Hero at bank",
            "script": "objects.getOne('hero').teleport({x:-3.5,y:2.14,z:7});"
          }
        ]
      }
    ]
  }
