  "testControls": {
    "panels": [
      {
        "title": "Bell Bug slug scooping",
        "x": 16,
        "y": 140,
        "statusTargetId": "crossing-slug",
        "buttons": [
          {
            "label": "Start alternating scoops",
            "script": "const b=[...objects].find(o=>o.definition?.id==='idle-bug-0'),s=[...objects].find(o=>o.definition?.id==='crossing-slug');b.app.timeScale=1;b.entity.rigidbody.teleport(new b.pc.Vec3(0,2.05,0),new b.pc.Vec3(0,0,0));s.entity.rigidbody.teleport(new b.pc.Vec3(0,2.05,-.72));s.health=s.maxHealth;s.gelMass.scoops=0;s.gelMass.opacity=.82;s.annoyance.level=0;s.annoyance.active=false;s.affection.charge=3;s.resolvePackTarget=()=>null;s.behavior.changeTo('LatchSeekState');b.scoop.reset();b.resolveRoyalTarget=()=>null;b.transition('BellBugPursueState');let previous=s.health,audioLogged=false,puddleLogged=false;if(b.scoopMonitor)b.scoopMonitor.off();b.scoopMonitor=b.app.on('update',()=>{if(s.floorPuddle?.sounded&&!puddleLogged){puddleLogged=true;console.info('FLOOR_PUDDLE',JSON.stringify({age:s.floorPuddle.age,active:s.floorPuddle.active,floor:s.floorPuddle.floor,opacity:s.floorPuddle.instance.parameters.material_opacity.data,splashPlaying:s.entity.sound.slot('splash').isPlaying,sourceVisible:s.floorPuddle.source.visible}));b.scoopMonitor.off();}if(b.scoop.tasted&&!audioLogged){audioLogged=true;console.info('SCOOP_AUDIO',JSON.stringify({tastePlaying:s.entity.sound.slot('scoopTaste').isPlaying,context:s.app.soundManager.context.state}));}if(s.health!==previous){previous=s.health;console.info('SLUG_SCOOP',JSON.stringify({health:s.health,maxHealth:s.maxHealth,annoyance:s.annoyance.level,affection:s.affection.charge,gelOpacity:s.gelMass.opacity,consumedScoops:s.gelMass.scoops,state:s.stateName,sounds:['scoopPress','scoopPull','scoopTaste'].map(name=>({name,playing:s.entity.sound?.slot(name)?.isPlaying})),foot:b.scoop.side,bugYaw:b.entity.getEulerAngles().y,slugPosition:s.position.toString()}));}});"
          },
          {
            "label": "Side view",
            "script": "camera.setViewport({zoom:7,rotation:1,panX:0,panZ:0});"
          },
          {
            "label": "Front view",
            "script": "camera.setViewport({zoom:7,rotation:0,panX:0,panZ:0});"
          },
          {
            "label": "Pause / resume",
            "script": "const b=[...objects].find(o=>o.definition?.id==='idle-bug-0');b.app.timeScale=b.app.timeScale===0?1:0;"
          },
          {
            "label": "Left foot taste pose",
            "script": "const b=[...objects].find(o=>o.definition?.id==='idle-bug-0'),s=[...objects].find(o=>o.definition?.id==='crossing-slug');b.scoop.reset();b.scoop.target=s;b.scoop.side=0;b.scoop.time=.98;b.scoop.contacted=true;b.app.timeScale=0;console.info('SCOOP_POSE',JSON.stringify({foot:b.scoop.side,time:b.scoop.time,yaw:b.entity.getEulerAngles().y}));"
          },
          {
            "label": "Right foot taste pose",
            "script": "const b=[...objects].find(o=>o.definition?.id==='idle-bug-0'),s=[...objects].find(o=>o.definition?.id==='crossing-slug');b.scoop.reset();b.scoop.target=s;b.scoop.side=1;b.scoop.time=.98;b.scoop.contacted=true;b.app.timeScale=0;console.info('SCOOP_POSE',JSON.stringify({foot:b.scoop.side,time:b.scoop.time,yaw:b.entity.getEulerAngles().y}));"
          },
          {
            "label": "Surface contact pose",
            "script": "const b=[...objects].find(o=>o.definition?.id==='idle-bug-0'),s=[...objects].find(o=>o.definition?.id==='crossing-slug');b.scoop.reset();b.scoop.target=s;b.scoop.side=0;b.scoop.time=.45;b.scoop.contacted=.45>=.45;b.app.timeScale=0;"
          },
          {
            "label": "Stretching gel pose",
            "script": "const b=[...objects].find(o=>o.definition?.id==='idle-bug-0'),s=[...objects].find(o=>o.definition?.id==='crossing-slug');b.scoop.reset();b.scoop.target=s;b.scoop.side=0;b.scoop.time=.68;b.scoop.contacted=.68>=.45;b.app.timeScale=0;"
          },
          {
            "label": "Capture bug preview",
            "script": "const b=[...objects].find(o=>o.definition?.id==='idle-bug-0');b.inspectClip('idle_nervous');b.scoop.reset();b.capturePreview().then(r=>console.info('SCOOP_PREVIEW',JSON.stringify(r)));"
          },
          {
            "label": "Capture slug preview",
            "script": "const b=[...objects].find(o=>o.definition?.id==='idle-bug-0'),s=[...objects].find(o=>o.definition?.id==='crossing-slug');b.scoop.reset();s.capturePreview().then(r=>console.info('SLUG_PREVIEW',JSON.stringify(r)));"
          },
          {
            "label": "Reload",
            "script": "window.location.reload();"
          },
          {
            "label": "Log surface and toe",
            "script": "const b=[...objects].find(o=>o.definition?.id==='idle-bug-0');const h=b.app.once('postrender',()=>{const c=b.scoop.contact,f=b.animationPlayback.scoopPose.foot(b.scoop.side);console.info('GEL_CONTACT',JSON.stringify({gelOpacity:[...objects].find(o=>o.definition?.id==='crossing-slug').gelMass.opacity,active:c?.active,surface:c?.point.toString(),toe:f.contactPoint?.toString(),triangles:c?.indices.length/3,patchVertices:c?.patch.positions.length/3,bodyMaterial:c?.source.material.name,pieceMaterial:c?.piece?.instance.material.name,contactError:b.scoop.time===.45&&c?f.contactPoint.distance(c.point):null}));});"
          },
          {
            "label": "Mixed slime moods",
            "script": "const b=[...objects].find(o=>o.definition?.id==='idle-bug-0'),s=[...objects].find(o=>o.definition?.id==='crossing-slug');if(!s?.alive){window.location.reload();return;}b.scoop.reset();b.inspectClip('idle_nervous');s.affection.charge=2;s.annoyance.level=5;s.annoyance.active=true;s.patPresentation.hud.update(.3);s.patPresentation.annoyanceHud.update(.3);b.app.timeScale=0;"
          },
          {
            "label": "Final living scoop",
            "script": "const b=[...objects].find(o=>o.definition?.id==='idle-bug-0'),s=[...objects].find(o=>o.definition?.id==='crossing-slug');if(!s?.alive){window.location.reload();return;}b.scoop.reset();b.inspectClip('idle_nervous');s.health=s.maxHealth/10;s.gelMass.scoops=9;s.gelMass.update(1);s.annoyance.level=5;s.annoyance.active=true;b.app.timeScale=1;b.app.once('postrender',()=>console.info('LATE_GEL_OPACITY',s.gelMass.opacity));"
          },
          {
            "label": "Collapse slime",
            "script": "const b=[...objects].find(o=>o.definition?.id==='idle-bug-0'),s=[...objects].find(o=>o.definition?.id==='crossing-slug');if(!s?.alive){window.location.reload();return;}b.scoop.reset();b.inspectClip('idle_nervous');b.entity.rigidbody.teleport(new b.pc.Vec3(2,2.05,1));s.gelMass.scoops=9;s.gelMass.update(1);b.app.timeScale=1;s.receiveDamage(s.health,b,'scoop');let stage=0;const h=b.app.on('update',()=>{if(s.floorPuddle&&s.floorPuddle.age>=[.2,.5,1.35][stage]){console.info('SLUMP_STAGE',JSON.stringify({age:s.floorPuddle.age,height:s.floorPuddle.mesh.aabb.halfExtents.y*2,parts:s.floorPuddle.parts.length,sounded:s.floorPuddle.sounded}));stage++;if(stage===3)h.off();}});"
          }
        ]
      }
    ]
  },
