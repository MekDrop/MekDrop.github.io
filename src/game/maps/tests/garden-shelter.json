            "label": "Toggle sunlight shadows",
            "script": "const s=[...objects].find(o=>o.definition?.object===\"GardenShelter\");const a=s.previewOptions.pc.Application.getApplication();const l=a.root.findByName('Sunlight').light;l.castShadows=!l.castShadows;console.info('SUN_SHADOWS',l.castShadows);"
          },
          {
            "label": "Inspect all vine sides",
            "script": "const s=[...objects].find(o=>o.definition?.object===\"GardenShelter\");(async()=>{for(const [yaw,elevation] of [[0,15],[90,15],[180,15],[270,15],[140,85],[140,-30],[140,25]]){const r=await s.capturePreview(yaw,elevation);console.info(\"PERGOLA_VIEW\",yaw,elevation,JSON.stringify(r));}await s.capturePreview(220,26,true);await s.capturePreview(220,15,true,new s.previewOptions.pc.Vec3(-1.4,2.8,-1.2));await s.capturePreview(220,16,true,new s.previewOptions.pc.Vec3(-1.02,2.31,-1.61),.22);}) ();"
          },
