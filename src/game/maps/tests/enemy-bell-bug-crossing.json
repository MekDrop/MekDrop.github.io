      "id": "crossing-check",
      "object": "TriggerArea",
      "position": {
        "x": 5,
        "y": 2.05,
        "z": 4
      },
      "color": "#334433",
      "script": "if(active&&!trigger.started){trigger.started=true;setTimeout(()=>{\nconst bugs=[...objects].filter(o=>o.definition?.id?.startsWith('idle-bug-')),slug=[...objects].find(o=>o.definition?.id==='crossing-slug'),b=bugs[0],camera=b.runtime.camera;\nfor(const bug of bugs){bug.resolveRoyalTarget=()=>null;bug.transition('BellBugPursueState')}\nconst origin=bugs.map(o=>o.position.clone()),goal={position:new b.pc.Vec3(1,2,-4),alive:true};slug.resolvePackTarget=()=>goal;slug.behavior.changeTo('LatchSeekState');\nb.app.root.findByName('Map test controls').enabled=false;\nconst cameraHandle=b.app.on('prerender',()=>{camera.component.orthoHeight=2.9;camera.entity.setPosition(5,7,6);camera.entity.lookAt(new b.pc.Vec3(.5,2.2,0))});\nconst chunks=[],samples=[],start=performance.now(),stream=document.querySelector('canvas').captureStream(30),rec=new MediaRecorder(stream,{mimeType:'video/webm;codecs=vp8'});let last=0,hopAttempt=null,nearDistance=null,done=false;\nrec.ondataavailable=e=>chunks.push(e.data);rec.onstop=()=>{const r=new FileReader();r.onload=()=>{const a=document.createElement('a');a.id='bell-crossing-video';a.href=r.result;a.hidden=true;document.body.appendChild(a)};r.readAsDataURL(new Blob(chunks,{type:'video/webm'}));stream.getTracks().forEach(t=>t.stop())};rec.start();\nconst update=b.app.on('update',()=>{if(!b.entity.rigidbody||!slug.entity.rigidbody){update.off();cameraHandle.off();if(rec.state!=='inactive')rec.stop();return}const time=(performance.now()-start)/1000;\nif(time>=8)goal.position.copy(bugs[1].position).add(new b.pc.Vec3(0,0,.1));\nif(time>=16&&hopAttempt===null){nearDistance=Math.min(...bugs.map(o=>Math.hypot(slug.position.x-o.position.x,slug.position.z-o.position.z)));hopAttempt=slug.beginIdleHop()}\nif(time-last>.1){samples.push({time,slug:{x:slug.position.x,y:slug.position.y,z:slug.position.z,airborne:slug.airborne,state:slug.stateName},bugs:bugs.map((o,i)=>({x:o.position.x,y:o.position.y,z:o.position.z,drift:Math.hypot(o.position.x-origin[i].x,o.position.z-origin[i].z)}))});last=time}\nif(time>=19&&!done){done=true;update.off();rec.stop();slug.testPlayClip('idle_dog');const stable=samples.filter(s=>s.time>.5),walking=stable.filter(s=>!s.slug.airborne);const report={crossed:Math.min(...samples.filter(s=>s.time<8).map(s=>s.slug.z))< -2,maxBugDrift:Math.max(...stable.flatMap(s=>s.bugs.map(o=>o.drift))),maxWalkingSlugY:Math.max(...walking.map(s=>s.slug.y)),nearHopAttemptAllowed:hopAttempt,nearHopDistance:nearDistance,samples};const a=document.createElement('a');a.id='bell-crossing-report';a.href='data:application/json;base64,'+btoa(JSON.stringify(report));a.hidden=true;document.body.appendChild(a);console.info('BELL_CROSSING_RESULT',JSON.stringify({...report,samples:samples.length}))}\n});\n},1600)}"
    }
