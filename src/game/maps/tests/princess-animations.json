  "testControls": {
    "panels": [
      {
        "title": "Princess skeleton review",
        "x": 16,
        "y": 140,
        "buttons": [
          {
            "label": "Stand at chair",
            "script": "for (const actor of objects) { const model = actor.entity?.findByTag('princess-review')[0]; if (model?.anim) { model.parent.setLocalPosition(0, 2.3, 0); model.anim.baseLayer.play('TerraceSit'); model.anim.speed = 0; model.anim.baseLayer.activeStateCurrentTime = 0; } }"
          },
          {
            "label": "Walk",
            "script": "for (const actor of objects) { const model = actor.entity?.findByTag('princess-review')[0]; if (model?.anim) { model.parent.setLocalPosition(-0.8, 2.3, 0); model.anim.speed = 1; model.anim.baseLayer.play('TerraceWalk'); model.anim.baseLayer.activeStateCurrentTime = 0; } }"
          },
          {
            "label": "Sit down",
            "script": "for (const actor of objects) { const model = actor.entity?.findByTag('princess-review')[0]; if (model?.anim) { model.parent.setLocalPosition(0, 2.3, 0); model.anim.speed = 1; model.anim.baseLayer.play('TerraceSit'); model.anim.baseLayer.activeStateCurrentTime = 0; } }"
          },
          {
            "label": "Hold seated / chair",
            "script": "for (const actor of objects) { const model = actor.entity?.findByTag('princess-review')[0]; if (model?.anim) { model.parent.setLocalPosition(0, 2.3, 0); model.anim.speed = 1; model.anim.baseLayer.play('RoyalSit'); model.anim.baseLayer.activeStateCurrentTime = 0; } }"
          },
          {
            "label": "Stand up",
            "script": "for (const actor of objects) { const model = actor.entity?.findByTag('princess-review')[0]; if (model?.anim) { model.parent.setLocalPosition(0, 2.3, 0); model.anim.baseLayer.play('TerraceSit'); model.anim.baseLayer.activeStateCurrentTime = 2; model.anim.speed = -1; } }"
          },
          {
            "label": "Cry / handkerchief",
            "script": "for (const actor of objects) { const model = actor.entity?.findByTag('princess-review')[0]; if (model?.anim) { model.parent.setLocalPosition(0, 2.3, 0); model.anim.speed = 1; model.anim.baseLayer.play('Cry'); model.anim.baseLayer.activeStateCurrentTime = 0; } }"
          },
          {
            "label": "Front",
            "script": "camera.setViewport({zoom:5.5,rotation:0,panX:0,panZ:0});"
          },
          {
            "label": "Side",
            "script": "camera.setViewport({zoom:5.5,rotation:1,panX:0,panZ:0});"
          },
          {
            "label": "Back",
            "script": "camera.setViewport({zoom:5.5,rotation:2,panX:0,panZ:0});"
          }
        ]
      }
    ]
  }
