  "testControls": {
    "panels": [
      {
        "title": "Snack Gobbler behavior",
        "x": 16,
        "y": 140,
        "statusTargetId": "snack-gobbler",
        "buttons": [
          {
            "label": "Resume royal pursuit",
            "script": "const royal=objects.getFirstByClass('King'); if(royal){const p=royal.definition.position;royal.entity.setPosition(p.x,p.y,p.z);} const g = objects.getFirstByClass('SnackGobbler'); g.testPlayClip(null);"
          },
          {
            "label": "Hungry meal test",
            "script": "const g = objects.getFirstByClass('SnackGobbler'); const food=objects.getFirstByClass('Divecap'); if(food?.alive){food.entity.rigidbody.teleport(g.position.clone().add(new g.pc.Vec3(.5,0,0)));g.hungryAt=0;g.sleepyUntil=0;g.health=30;g.testPlayClip(null);}"
          },
          {
            "label": "Ring bell (ignored)",
            "script": "const g = objects.getFirstByClass('SnackGobbler'); g.onBellRung({eventId:'test-'+g.elapsed});"
          },
          {
            "label": "Carry by ogre",
            "script": "const g = objects.getFirstByClass('SnackGobbler'); g.beginCarry(objects.getFirstByClass('PitcherOgre'));"
          },
          {
            "label": "Throw from carrier",
            "script": "const g = objects.getFirstByClass('SnackGobbler'); g.launch({velocity:new g.pc.Vec3(2,4,0)});"
          },
          {
            "label": "External stun",
            "script": "const g = objects.getFirstByClass('SnackGobbler'); g.applyStatus('stun',{duration:2});"
          },
          {
            "label": "Damage 15",
            "script": "const g = objects.getFirstByClass('SnackGobbler'); g.receiveDamage(15);"
          },
          {
            "label": "Death",
            "script": "const g = objects.getFirstByClass('SnackGobbler'); g.receiveDamage(g.health);"
          },
          {
            "label": "Run live behavior audit",
            "script": "objects.getFirstByClass('SnackGobbler').behaviorAudit.run();"
          }
        ]
      },
      {
        "title": "Embedded clips / evidence",
        "x": 1024,
        "y": 140,
        "statusTargetId": "snack-gobbler",
        "buttons": [
          {
            "label": "Previous clip",
            "script": "const g = objects.getFirstByClass('SnackGobbler'); g.testStepClip(-1);"
          },
          {
            "label": "Next clip",
            "script": "const g = objects.getFirstByClass('SnackGobbler'); g.testStepClip(1);"
          },
          {
            "label": "Audit every clip",
            "script": "const g = objects.getFirstByClass('SnackGobbler'); g.playbackAudit.start();"
          },
          {
            "label": "Capture transparent preview",
            "script": "const g = objects.getFirstByClass('SnackGobbler'); g.testCapturePreview().then(result=>console.info('GobblerPreviewEvidence',JSON.stringify(result)));"
          },
          {
            "label": "Half animation speed",
            "script": "const g = objects.getFirstByClass('SnackGobbler'); g.model.anim.speed=.5;"
          },
          {
            "label": "Normal animation speed",
            "script": "const g = objects.getFirstByClass('SnackGobbler'); g.model.anim.speed=1;"
          },
          {
            "label": "Front camera",
            "script": "const g=objects.getFirstByClass('SnackGobbler');camera.setViewport({zoom:5,rotation:0,panX:g.position.x,panZ:g.position.z});"
          },
          {
            "label": "Isometric camera",
            "script": "const g=objects.getFirstByClass('SnackGobbler');camera.setViewport({zoom:5,rotation:2,panX:g.position.x,panZ:g.position.z});"
          }
        ]
      }
    ]
  },
