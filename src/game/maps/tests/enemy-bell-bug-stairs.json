      "id": "bell-stairs-review",
      "object": "TriggerArea",
      "position": {
        "x": 4,
        "y": 2.05,
        "z": 4
      },
      "color": "#334433",
      "script": "if(active&&!trigger.started){trigger.started=true;setTimeout(()=>{\nconst b=[...objects].find(o=>o.definition?.id==='bell-bug'),stair=[...objects].find(o=>o.definition?.id==='bell-stairs');\nb.app.root.findByName('Map test controls').enabled=false;\nconst points=[[-1,3.214,-3],[1,3.214,-3],[1,4.414,2.2],[1,3.214,-3],[-1,3.214,-3],[-1,2.014,2.2]].map(p=>new b.pc.Vec3(...p));\nlet index=0,previous=b.position.clone(),direction=points[0].clone().sub(previous);direction.y=0;direction.normalize();\nconst goal={position:points[0].clone()};b.resolveRoyalTarget=()=>goal;b.transition('BellBugPursueState');\nconst chunks=[],stream=document.querySelector('canvas').captureStream(30),recorder=new MediaRecorder(stream,{mimeType:'video/webm;codecs=vp8'}),samples=[];\nrecorder.ondataavailable=e=>chunks.push(e.data);recorder.onstop=()=>{const reader=new FileReader();reader.onload=()=>{const a=document.createElement('a');a.id='bell-stair-video';a.href=reader.result;a.style.display='none';document.body.appendChild(a);document.body.dataset.bellStairs='complete'};reader.readAsDataURL(new Blob(chunks,{type:'video/webm'}));stream.getTracks().forEach(t=>t.stop())};\nconst started=performance.now();let lastProgress=started,best=Infinity,nextSample=0,done=false;\nconst camera=b.runtime.camera;const cameraHandle=b.app.on('prerender',()=>{const p=b.position;camera.component.orthoHeight=2.1;const side=p.x<-.2?-1:1;const desired=new b.pc.Vec3(p.x+side*5,p.y+3.6,p.z-4.5);camera.entity.setPosition(camera.entity.getPosition().clone().lerp(camera.entity.getPosition(),desired,.1));camera.entity.lookAt(p.clone().add(new b.pc.Vec3(0,.35,0)))});\nconst finish=(reason)=>{if(done)return;done=true;update.off();b.inspectClip('idle_nervous');recorder.stop();setTimeout(async()=>{const click=HTMLAnchorElement.prototype.click;HTMLAnchorElement.prototype.click=function(){this.id='bell-stair-preview';this.style.display='none';document.body.appendChild(this)};try{console.info('BELL_STAIRS_PREVIEW',JSON.stringify(await b.capturePreview()))}finally{HTMLAnchorElement.prototype.click=click}},500);const report={reason,completed:index>=points.length,checkpoints:index,expectedCheckpoints:points.length,minY:Math.min(...samples.map(s=>s.y)),maxY:Math.max(...samples.map(s=>s.y)),duration:(performance.now()-started)/1000,samples};const a=document.createElement('a');a.id='bell-stair-report';a.href='data:application/json;base64,'+btoa(JSON.stringify(report));a.style.display='none';document.body.appendChild(a);console.info('BELL_STAIRS_RESULT',JSON.stringify({...report,samples:samples.length}))};\nconst update=b.app.on('update',()=>{if(!b.entity.rigidbody){update.off();cameraHandle.off();if(recorder.state!=='inactive')recorder.stop();return}const now=performance.now(),p=b.position,waypoint=points[index];if(!waypoint)return;\nconst distance=Math.hypot(p.x-waypoint.x,p.z-waypoint.z);if(distance<.14&&Math.abs(p.y-waypoint.y)<.38){previous=waypoint;index++;best=Infinity;lastProgress=now;if(index>=points.length){finish('completed ascent and descent');return}direction=points[index].clone().sub(previous);direction.y=0;direction.normalize()}\ngoal.position.copy(points[index]).add(direction.clone().mulScalar(.9));const remaining=p.distance(points[index]);if(remaining<best-.035){best=remaining;lastProgress=now}\nif(now>=nextSample){samples.push({time:(now-started)/1000,x:p.x,y:p.y,z:p.z,checkpoint:index,clip:b.clip,vY:b.entity.rigidbody.linearVelocity.y});nextSample=now+100}\nif(now-lastProgress>4500)finish('stalled at checkpoint '+index);else if(now-started>90000)finish('timeout');\n});recorder.start();\n},1800)}"
    }
