            "label": "Other side",
            "script": "camera.setFirstPerson(false); camera.setViewport({zoom:4,rotation:0,panX:-14,panZ:-10.5});"
          },
          {
            "label": "Inside tower",
            "script": "const castle = objects.getAll('castle').find(c => c.definition.id === 'signal-castle'); const room = castle.definition.buildPlan.metadata.runtime.residential.roofAccess.bottom; const hero = objects.getOne('hero'); hero.teleport({...room,y:room.y+0.02}); hero.firstPersonCameraEnabled = true; hero.firstPersonFacingYaw = 180; camera.setFirstPerson(true);"
          }
        ]
      }
    ]
