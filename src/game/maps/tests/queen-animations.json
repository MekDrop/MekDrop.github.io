  "testControls": {
    "panels": [
      {
        "title": "Queen skeleton / all animations",
        "x": 16,
        "y": 140,
        "buttons": [
          {
            "label": "TerraceIdle",
            "script": "for (const actor of objects) { if (actor.entity?.name.endsWith(' animation actor')) { const model = actor.entity.findByTag('map-animation-actor')[0]; if (model?.anim) { actor.entity.enabled = model.tags.has('TerraceIdle'); if (actor.entity.enabled) { actor.entity.setLocalPosition(0,2.3,0); model.anim.speed = 1; model.anim.baseLayer.play('TerraceIdle'); model.anim.baseLayer.activeStateCurrentTime = 0; } } } } camera.setViewport({zoom:5.5,rotation:0,panX:0,panZ:0});"
          },
          {
