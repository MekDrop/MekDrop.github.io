  "testControls": {
    "panels": [
      {
        "title": "One-sided stairs",
        "statusTargetId": "overpass",
        "buttons": [
          {
            "label": "Overview",
            "script": "camera.setViewport({zoom:8,rotation:0,panX:.5,panZ:-.5});"
          },
          {
            "label": "Deck view",
            "script": "camera.setViewport({zoom:4,rotation:0,panX:.5,panZ:-.5});"
          },
          {
            "label": "Hero on deck",
            "script": "objects.getOne('hero').teleport({x:.5,y:4.05,z:-.5});camera.setViewport({zoom:4,rotation:0,panX:.5,panZ:-.5});"
          },
          {
            "label": "Smash crossing",
            "script": "const crossing=[...objects].find(o=>o.definition?.id==='overpass');const hero=objects.getOne('hero');hero.teleport({x:.5,y:4.05,z:-1.5});camera.setViewport({zoom:4,rotation:0,panX:.5,panZ:-.5});window.setTimeout(()=>hero.smashBridge({targetX:.5,targetZ:-.5,onImpact:()=>crossing.collapseStation(7)}),400);"
          },
          {
            "label": "Destroy crossing",
            "script": "const crossing=[...objects].find(o=>o.definition?.id==='overpass');crossing.collapseStation(7);"
          },
          {
            "label": "Underpass view",
            "script": "objects.getOne('hero').teleport({x:-2,y:2.02,z:-.5});camera.setViewport({zoom:4,rotation:1,panX:.5,panZ:-.5});"
          }
        ]
      },
      {
        "title": "Enemy drop",
        "buttons": [
          {
            "label": "Place walker",
            "script": "const actor=[...objects].find(o=>o.definition?.id==='collapse-walker');actor.entity.rigidbody.teleport(.5,4.05,-.5);actor.entity.rigidbody.linearVelocity=new actor.pc.Vec3();actor.applyStatus('stun',{duration:6});objects.getOne('hero').teleport({x:-3,y:2.02,z:-.5});camera.setViewport({zoom:4,rotation:0,panX:.5,panZ:-.5});"
          },
          {
            "label": "Place jumper",
            "script": "const actor=[...objects].find(o=>o.definition?.id==='collapse-jumper');actor.entity.rigidbody.teleport(.5,4.05,-.5);actor.entity.rigidbody.linearVelocity=new actor.pc.Vec3();actor.applyStatus('stun',{duration:6});objects.getOne('hero').teleport({x:-3,y:2.02,z:-.5});camera.setViewport({zoom:4,rotation:0,panX:.5,panZ:-.5});"
          },
          {
            "label": "Place flyer",
            "script": "const actor=[...objects].find(o=>o.definition?.id==='collapse-flyer');actor.entity.rigidbody.teleport(.5,4.05,-.5);actor.entity.rigidbody.linearVelocity=new actor.pc.Vec3();objects.getOne('hero').teleport({x:-3,y:2.02,z:-.5});camera.setViewport({zoom:4,rotation:0,panX:.5,panZ:-.5});"
          },
          {
            "label": "Drop occupied crossing",
            "script": "const crossing=[...objects].find(o=>o.definition?.id==='overpass');crossing.collapseStation(7);"
          },
          {
            "label": "Pursuit walker",
            "script": "const crossing=[...objects].find(o=>o.definition?.id==='overpass');crossing.collapseStation(7);for(const actor of objects){if(!actor.definition?.id?.startsWith('collapse-'))continue;const selected=actor.definition.id==='collapse-walker';actor.entity.rigidbody.teleport(selected ? 0.5 : -4,selected?4.05:2.02,selected?-1.5:6);actor.entity.rigidbody.linearVelocity=new actor.pc.Vec3();actor.entity.setEulerAngles(0,0,0);if(selected){actor.statuses.delete('stun');}else{actor.applyStatus('stun',{duration:120});}}const goal=objects.getOne('hero');goal.isRoyal=true;goal.teleport({x:3,y:2.02,z:.5});camera.setViewport({zoom:4,rotation:0,panX:.5,panZ:-.5});window.overpassActors=[...objects];window.overpassMap=map;"
          },
          {
            "label": "Pursuit jumper",
            "script": "const crossing=[...objects].find(o=>o.definition?.id==='overpass');crossing.collapseStation(7);for(const actor of objects){if(!actor.definition?.id?.startsWith('collapse-'))continue;const selected=actor.definition.id==='collapse-jumper';actor.entity.rigidbody.teleport(selected ? 0.5 : -4,selected?4.05:2.02,selected?-1.5:6);actor.entity.rigidbody.linearVelocity=new actor.pc.Vec3();actor.entity.setEulerAngles(0,0,0);if(selected){actor.statuses.delete('stun');}else{actor.applyStatus('stun',{duration:120});}}const goal=objects.getOne('hero');goal.isRoyal=true;goal.teleport({x:3,y:2.02,z:.5});camera.setViewport({zoom:4,rotation:0,panX:.5,panZ:-.5});window.overpassActors=[...objects];window.overpassMap=map;"
          },
          {
            "label": "Pursuit flyer",
            "script": "const crossing=[...objects].find(o=>o.definition?.id==='overpass');crossing.collapseStation(7);for(const actor of objects){if(!actor.definition?.id?.startsWith('collapse-'))continue;const selected=actor.definition.id==='collapse-flyer';actor.entity.rigidbody.teleport(selected ? 0.5 : -4,selected?4.05:2.02,selected?-1.5:6);actor.entity.rigidbody.linearVelocity=new actor.pc.Vec3();actor.entity.setEulerAngles(0,0,0);if(selected){actor.statuses.delete('stun');}else{actor.applyStatus('stun',{duration:120});}}const goal=objects.getOne('hero');goal.isRoyal=true;goal.teleport({x:3,y:2.02,z:.5});camera.setViewport({zoom:4,rotation:0,panX:.5,panZ:-.5});window.overpassActors=[...objects];window.overpassMap=map;"
          }
        ]
      }
    ]
  }
}
