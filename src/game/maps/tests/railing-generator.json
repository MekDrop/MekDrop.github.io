  "testControls": {
    "panels": [
      {
        "title": "Dynamic railing",
        "statusTargetId": "live-railing",
        "buttons": [
          {
            "label": "Shorten to 3 m",
            "script": "for (const rail of objects) { if (rail.definition?.id === 'live-railing') rail.regenerate({\"length\":3}); }"
          },
          {
            "label": "Extend to 7 m",
            "script": "for (const rail of objects) { if (rail.definition?.id === 'live-railing') rail.regenerate({\"position\":{\"x\":-3.5,\"y\":2,\"z\":0},\"length\":7,\"direction\":{\"x\":1,\"y\":0,\"z\":0}}); }"
          },
          {
            "label": "Turn diagonal",
            "script": "for (const rail of objects) { if (rail.definition?.id === 'live-railing') rail.regenerate({\"position\":{\"x\":-2,\"y\":2,\"z\":-2},\"length\":5,\"direction\":{\"x\":1,\"y\":0,\"z\":1}}); }"
          },
          {
            "label": "Move and reverse",
            "script": "for (const rail of objects) { if (rail.definition?.id === 'live-railing') rail.regenerate({\"position\":{\"x\":3,\"y\":2,\"z\":1},\"length\":6,\"direction\":{\"x\":-1,\"y\":0,\"z\":0}}); }"
          }
        ]
      }
    ]
