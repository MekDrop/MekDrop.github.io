            "label": "Floating bridge view",
            "script": "objects.getOne('hero').teleport({x:-3.5,y:2.14,z:7});camera.setViewport({zoom:2.3,rotation:0,panX:0,panZ:7});"
          },
          {
            "label": "Smash floating bridge",
            "script": "const bridge=[...objects].find(o=>o.definition?.object==='Bridge'&&o.definition.span?.start===5&&o.definition.span?.crossCenter===17.5);const hero=objects.getOne('hero');if(bridge&&hero){hero.teleport({x:-3.5,y:2.14,z:7});camera.setViewport({zoom:2.3,rotation:0,panX:0,panZ:7});window.setTimeout(()=>hero.smashBridge({targetX:-2.5,targetZ:7,onImpact:()=>bridge.collapseStation(5)}),400);}"
